{
  "name": "nickpeterson",
  "author": "Nick Peterson",
  "version": "1.0.0",
  "type": "module",
  "description": "This is the resume of Nick Peterson.",
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "build": "rm -rf build && rm -f index.html nick-peterson.pdf && pnpm run make-html && pnpm run make-pdf",
    "make-html": "node ./scripts/generate-html.js",
    "make-pdf": "node ./scripts/generate-pdf.js",
    "open-html": "chrome ./index.html",
    "open-pdf": "chrome ./nick-peterson.pdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklpeterson/resume.git"
  },
  "keywords": [
    "resume"
  ],
  "devDependencies": {
    "prettier": "^3.6.2",
    "puppeteer": "^24.27.0",
    "pug": "^3.0.3"
  }
}