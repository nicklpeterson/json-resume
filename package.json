{
  "name": "nickpeterson",
  "author": "Nick Peterson",
  "version": "1.0.0",
  "type": "module",
  "description": "This is the resume of Nick Peterson.",
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "build": "rm index.html nick-peterson.pdf && pnpm run fetch-html && pnpm run make-pdf",
    "make-pdf": "node ./scripts/generate-pdf.js",
    "fetch-html": "curl https://registry.jsonresume.org/nicklpeterson?theme=government-standard | prettier --parser html >> index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklpeterson/resume.git"
  },
  "keywords": [
    "resume"
  ],
  "devDependencies": {
    "prettier": "^3.6.2",
    "puppeteer": "^24.27.0"
  }
}