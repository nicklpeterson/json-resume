doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Nick Peterson - Resume
    style.
      .resume-section {
        margin-bottom: var(--resume-space-section, 2rem);
      }

      .resume-section-title {
        font-size: 14pt;
        font-weight: bold;
        color: #000000;
        margin: 18pt 0 12pt 0;
        padding-bottom: 4pt;
        border-bottom: 1pt solid #000000;
        text-transform: uppercase;
        
      }

      .resume-date-range {
        font-size: var(--resume-size-small, 10pt);
        color: var(--resume-color-tertiary, #666);
        white-space: nowrap;
      }

      .resume-contact {
        display: flex;
        justify-content: center;
        gap: var(--resume-space-small, 12px);
        flex-wrap: wrap;
        font-size: 11pt;
        color: #000000;
        text-align: center;
      }
      .resume-contact a {
        font-size: 11pt;
        color: #000000;
        text-decoration: underline;
      }

      .contact-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .contact-separator {
        color: var(--resume-color-muted, #999);
      }

      @media screen and (max-width: 800px) {
        .hide-on-mobile {
          display: none;
        }

        .resume-container {
          max-width: 100%;
        }
      }

      @media screen and (min-width: 800px) {
        .resume-container {
          max-width: 80%;
        }
      }

      .resume-container {
        margin: 0 auto;
        padding: 10%;
        background: #ffffff;
        font-size: 12pt;
        color: #000000;
        line-height: 1.4;
      }

      .resume-header {
        text-align: center;
        margin-bottom: 24pt;
        padding-bottom: 12pt;
        border-bottom: 2pt solid #000000;
      }

      .resume-name {
        font-size: 18pt;
        font-weight: bold;
        color: #000000;
        margin: 0 0 6pt 0;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .resume-role {
        font-size: 12pt;
        color: #000000;
        margin-bottom: 8pt;
        font-weight: normal;
      }

      .resume-summary {
        font-size: 12pt;
        line-height: 1.4;
        color: #000000;
        margin: 12pt 0 0 0;
        text-align: left;
      }

      .experience-item {
        margin-bottom: 18pt;
        page-break-inside: avoid;
      }
      .experience-item:last-child {
        margin-bottom: 0;
      }

      .experience-header {
        margin-bottom: 6pt;
      }

      .experience-role {
        font-size: 13pt;
        font-weight: bold;
        color: #000000;
        margin: 0 0 3pt 0;
      }

      .experience-company {
        font-size: 12pt;
        color: #000000;
        font-weight: normal;
        margin-bottom: 3pt;
      }

      .experience-meta {
        font-size: 11pt;
        color: #111827;
        font-weight: normal;
        font-style: italic;
      }

      .experience-list {
        margin: 6pt 0 0 18pt;
        padding: 0;
        list-style-type: disc;
      }
      .experience-list li {
        margin: 3pt 0;
        color: #000000;
        line-height: 1.4;
        font-size: 12pt;
      }

      .education-item {
        margin-bottom: 12pt;
        page-break-inside: avoid;
      }
      .education-item:last-child {
        margin-bottom: 0;
      }

      .education-institution {
        font-size: 13pt;
        font-weight: bold;
        color: #000000;
        margin: 0 0 3pt 0;
      }

      .education-degree {
        font-size: 12pt;
        color: #000000;
        margin-bottom: 3pt;
      }

      .education-meta {
        font-size: 11pt;
        color: #111827;
        font-style: italic;
      }

      .skills-item {
        margin-bottom: 12pt;
      }

      .skills-item:last-child {
        margin-bottom: 0;
      }

      .skills-label {
        font-size: 12pt;
        font-weight: bold;
        color: #000000;
        margin: 0 0 3pt 0;
        display: inline;
      }

      .skills-values {
        font-size: 12pt;
        color: #000000;
        font-weight: normal;
      }

    style.
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        font-family: "Helvetica"
      }

      @media print {
        .experience-item {
          page-break-inside: avoid;
        }

        body {
          background: white;
        }

        @page {
          margin: 1in;
        }

        .resume-container {
          padding: 0;
          margin: 0;
        }
      }

  body
    .resume-container
      header.resume-header
        h1.resume-name #{basics.name}
        .resume-role #{basics.label}
        .resume-contact
          span.contact-item
            a(href="mailto:nick.peterson@alumni.ubc.ca" aria-label="Email") #{basics.email}
          span.hide-on-mobile.contact-separator(aria-hidden="true") •
          span.contact-item #{basics.phone}
          span.hide-on-mobile.contact-separator(aria-hidden="true") •
          span.hide-on-mobile.contact-item(aria-label="Location") #{basics.location.city}, #{basics.location.region}
          span.hide-on-mobile.contact-separator(aria-hidden="true") •
          each profile, index in basics.profiles
            span.hide-on-mobile.contact-item
              a(
                href=profile.url
                aria-label=profile.network
                target="_blank"
                rel="noopener noreferrer"
              ) #{profile.network}
            if index < basics.profiles.length - 1
              span.hide-on-mobile.contact-separator(aria-hidden="true") •        

      section.resume-section
        p.resume-summary #{basics.summary}

      section.resume-section
        h2.resume-section-title Professional Experience

        each experience in work 
          .experience-item
            .experience-header
              h3.experience-role #{experience.position}
              .experience-company #{experience.name}
              .experience-meta 
                span.resume-date-range #{experience.startDate} - #{experience.endDate}
            ul.experience-list
              each highlight in experience.highlights
                li=highlight

      section.resume-section
        h2.resume-section-title Education

        each item in education 
          .education-item 
            h3.education-institution #{item.institution}
            .education-degree #{item.studyType} in #{item.area}
            .education-meta
              span.resume-date-range #{item.startDate} - #{item.endDate}

      section.resume-section
        h2.resume-section-title Professional Skills

        each skill in skills
          .skills-item 
            h4.skills-label #{skill.name + ": "}
            span.skills-values #{skill.keywords.join(", ")}
